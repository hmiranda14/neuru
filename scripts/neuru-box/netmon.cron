# Edit this file to introduce tasks to be run by cron.
# 
# Each task to run has to be defined through a single line
# indicating with different fields when the task will be run
# and what command to run for the task
# 
# To define the time you can provide concrete values for
# minute (m), hour (h), day of month (dom), month (mon),
# and day of week (dow) or use '*' in these fields (for 'any').
# 
# Notice that tasks will be started based on the cron's system
# daemon's notion of time and timezones.
# 
# Output of the crontab jobs (including errors) is sent through
# email to the user the crontab file belongs to (unless redirected).
# 
# For example, you can run a backup of all your user accounts
# at 5 a.m every week with:
# 0 5 * * 1 tar -zcf /var/backups/home.tgz /home/
# 
# For more information see the manual pages of crontab(5) and cron(8)
# 
# m h  dom mon dow   command
# Ping poller — mantiene nodos ping frescos (cada minuto)
* * * * * /opt/netmon-venv/bin/python3 /var/www/html/netmon/scripts/nm_ping.py >> /home/neuru/netmon-logs/nm_ping.log 2>&1
# SNMP poller — nodos/stats SNMP (cada 2 min)
*/2 * * * * /opt/netmon-venv/bin/python3 /var/www/html/netmon/scripts/nm_poller.py >> /home/neuru/netmon-logs/nm_poller.log 2>&1
# Container network history — alimenta el widget del dashboard (cada minuto)
* * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_netstats.php >/dev/null 2>&1
# Smokeping latency history → NEURU DB (cada 5 min)
*/5 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_smokeping.php >/dev/null 2>&1

# NetFlow — evalúa alertas de ancho de banda por aplicación (cada minuto)
* * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_netflow.php >/dev/null 2>&1
# Incident correlation — agrupa todas las alertas en incidentes (cada minuto)
* * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_incidents.php >/dev/null 2>&1
# Reportes SLA programados — chequea cada hora si toca enviar
0 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_reports.php >/dev/null 2>&1

# Router Configuration Manager — backup running-config de cada router vía n8n y compara (2:30am UTC)
# (vía curl→localhost para correr como www-data: solo ese usuario puede leer .nm_secret.key y descifrar las creds SSH)
30 2 * * * /var/www/html/netmon/scripts/nm_cron.sh cron_config.php >> /home/neuru/netmon-logs/cron_config.log 2>&1

# Backup diario (codigo + DB) a /home/neuru/netmon-backups (3am UTC)
0 3 * * * sh /home/neuru/netmon-backup.sh >> /home/neuru/netmon-logs/backup.log 2>&1

# Predictive Health — colector óptico/ethernet (errores SFP DOM + CRC/FCS) cada 5 min
*/5 * * * * /opt/netmon-venv/bin/python3 /var/www/html/netmon/scripts/nm_health.py >> /home/neuru/netmon-logs/nm_health.log 2>&1
# Predictive Health — evalúa tendencias y predice falla en N días (cada hora :15)
15 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_health.php >/dev/null 2>&1
# Collective Immunity — detecta port-scans/DNS malicioso y (si auto) vacuna toda la flota (cada 3 min)
*/3 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_immunity.php >/dev/null 2>&1
# Self-Healing — corre playbooks habilitados (detect→propose/act) + auto-revert (cada 2 min; no hace nada con playbooks OFF)
*/2 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_heal.php >/dev/null 2>&1
# AI Commander V2 — reapea sesiones colgadas + escanea el signal-bus + dispatcha investigaciones (cada min; no-op si ap2_enabled OFF)
* * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_autopilotv2.php >/dev/null 2>&1
# Wear/Stress — daily snapshot del índice para el sparkline de tendencia (4:30am)
30 4 * * * /var/www/html/netmon/scripts/nm_cron.sh cron_wear.php >/dev/null 2>&1
# Shadow IT — fingerprint NetFlow para VPN/minería no autorizada (advisory, cada 10 min)
*/10 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_shadowit.php >/dev/null 2>&1
# AI Archaeologist — minería de correlaciones cruzadas (semanal, lunes 5:30am)
30 5 * * 1 /var/www/html/netmon/scripts/nm_cron.sh cron_archaeology.php >/dev/null 2>&1
# Weather-Aware Routing — dispara el poll de clima en n8n + limpia alertas vencidas (cada 15 min)
*/15 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_weather.php >/dev/null 2>&1
# TP-Link Easy Smart switches — scrape port stats (sin SNMP/syslog): pps + link flaps + bad-packet alerts (cada 2 min)
*/2 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_tplink.php >/dev/null 2>&1
# WireGuard peer monitoring — handshake + per-peer traffic over SSH (cada 2 min)
*/2 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_wireguard.php >/dev/null 2>&1
# AI/GPU monitor — nvidia-smi/rocm-smi + Ollama telemetry over SSH (cada 2 min)
*/2 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_gpu.php >/dev/null 2>&1
# Windows Monitor — agentless event-log + sensors over SSH (cada 5 min)
*/5 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_winhost.php >/dev/null 2>&1
# Linux Monitor — agentless node metrics over SSH (cada 5 min)
*/5 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_linuxhost.php >/dev/null 2>&1
* * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_dbmon.php
*/2 * * * * php /var/www/html/netmon/cron_aiopilot.php >> /home/neuru/netmon-logs/cron_aiopilot.log 2>&1
# NetAIObot two-way Telegram approvals — read Approve/Deny taps + apply (cada minuto)
* * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_aip_telegram.php >/dev/null 2>&1
# Deception Grid — auto-revert diversions past their TTL (safety net, cada minuto)
* * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_decoy.php >/dev/null 2>&1
# Service Biosphere — probe every service (DNS/HTTP/SQL/SMTP), store a sample, prune (cada minuto)
* * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_biosphere.php >/dev/null 2>&1
* * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_cluster.php >/dev/null 2>&1

# NEURU Cisco Suite — env sensors + CDP neighbors for Cisco devices (every 5 min)
*/5 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_cisco.php >/dev/null 2>&1

# NEURU self-update — check the license portal daily (honors the update policy: manual/notify/auto)
23 4 * * * /var/www/html/netmon/scripts/nm_cron.sh cron_update.php >/dev/null 2>&1

# NEURU license heartbeat — revalidate every 6h (keeps the token fresh; free never lapses while it beats)
17 */6 * * * /var/www/html/netmon/scripts/nm_cron.sh cron_license.php >/dev/null 2>&1

# Notification Center — digest flush + failing-channel self-alert (every 5 min)
*/5 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_notify.php >/dev/null 2>&1
0 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_vault.php >/dev/null 2>&1
*/3 * * * * /var/www/html/netmon/scripts/nm_cron.sh cron_sentinel.php >/dev/null 2>&1
*/30 * * * * /opt/netmon-venv/bin/python3 /var/www/html/netmon/scripts/nm_ipam_scan.py >> /home/neuru/netmon-logs/nm_ipam_scan.log 2>&1
